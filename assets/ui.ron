// The colours and the words of everything drawn over the world, and every
// number of how the car you drive goes (at the end, under `car`), for
// changing by hand (src/ui.rs reads it). Sizes and layout stay in the code.
//
// A colour is written as on the web: "#rrggbb", or "#rrggbbaa" with its
// alpha (00 invisible, ff solid). In VS Code, with editor.defaultColorDecorators
// set to always, each one has a swatch, and hovering it opens a colour
// picker that rewrites it; rgb(), rgba(), hsl() and hsla() read too.
// On Windows, with the game running from `cargo run`, save
// this file and the screen takes the new colours and words within a quarter
// of a second: the bar across the top, the sign-up's pages, the settings
// window and the names over heads at once, a dialog or the shop when it is
// next opened, and the car at once, driving or not. A file that will not
// read is logged and the last good one kept. A phone shows whatever this
// file said when its app was built.
(
    colours: (
        // Words, wherever they are: plain, small print, and the shadow under
        // words that stand over the world (black: a dark blue until
        // late on 2026-11-11, when every blue tint went).
        text: "#ffffff",
        text_soft: "#ffffffc7",
        text_shadow: "#00000066",
        // Gold: titles, prizes, lit stars, a chosen tab, and the gold buttons
        // (Play again, the settings' Save), lit under the pointer; and the
        // dark blue of words on gold.
        gold: "#edb62a",
        gold_lit: "#ffe88c",
        on_gold: "#fafafa",
        // A warning: Delete account, "not available yet", "Need 100 coins";
        // and Delete lit under the pointer.
        warn: "#ad311e",
        warn_lit: "#d03a1c",
        // Dialogs: the dark over the world behind one, the dialog itself, and
        // the glass behind words that stand over the world (Bridge Wars' and
        // House Builder's time, the hammer), lit under the pointer: the very
        // grey of your name's plate (hud.name_plate), as the minimap's
        // background, the shop's window and the settings' are that grey
        // too, each as solid as its own alpha says.
        dim: "#00000073",
        dialog: "#000000d9",
        panel: "#66666673",
        panel_lit: "#66666699",
        // A quiet button (Cancel, Later, Exit, a tab not chosen), lit under
        // the pointer; a button that cannot be pressed, and its words; and
        // the cross on a window's corner (the same grey, solid; red until
        // late on 2026-11-11), with its rim.
        quiet: "#ffffff24",
        quiet_lit: "#ffffff42",
        off: "#ffffff12",
        off_text: "#ffffff59",
        close: "#666666",
        close_rim: "#ffffffb2",
        // The bar across the top and the round buttons, which a phone's stick
        // and jump button share: a button's disc, the jump button while it is
        // held, the picture on each (and the stick's knob), your name's
        // plate, and the pictures drawn in code on other buttons.
        hud: (
            button: "#66666652",
            button_held: "#66666680",
            button_mark: "#ffffff85",
            name_plate: "#66666673",
            icon: "#fffffff0",
        ),
        // The opening, as the app starts: the cover the town loads under,
        // which opens as a circle about where you land; the town's name on
        // it (words.welcome), which stays over the town for a moment as it
        // opens; and the ring of dust that goes out from your feet as you
        // land, as see-through as its alpha says.
        intro: (
            cover: "#000000",
            title: "#ffffff",
            dust: "#ffffffb3",
        ),
        // The sign-up's pages: the page; the box the name goes in and the
        // characters' cards, lit under the pointer; the chosen card; a button
        // and its words, lit under the pointer; and the arrows beside the
        // cards.
        signup: (
            page: "#000000",
            field: "#262629",
            field_lit: "#363638",
            chosen: "#5c5c61",
            paper: "#ffffff",
            paper_lit: "#d6d6d9",
            ink: "#0d0d0f",
            arrow: "#ffffffd9",
        ),
        // The settings: the window's glass, and a sign-in not to be had yet,
        // blocked out, with its words.
        settings: (
            window: "#666666d1",
            blocked: "#ffffff14",
            blocked_text: "#ffffff66",
        ),
        // House Builder: a star not given; the results behind their rows, a
        // row, your row, the second and third medals (the first is gold), and
        // a prize of nothing.
        house_builder: (
            star_off: "#ffffff66",
            results: "#000000b2",
            row: "#ffffff12",
            your_row: "#ffd64c42",
            silver: "#ccd6e6",
            bronze: "#db8f54",
            no_prize: "#ffffff73",
        ),
        // The shop: its window, the hammer's rim and handle, a card, lit
        // under the pointer, a card that cannot be chosen with its picture
        // and name, and the note that says why.
        shop: (
            window: "#666666db",
            hammer_rim: "#ffffff80",
            handle: "#f5c785",
            card: "#ffffff1a",
            card_lit: "#ffffff38",
            card_off: "#ffffff0a",
            picture_off: "#ffffff4c",
            name_off: "#ffffff59",
            note: "#ffd199",
        ),
        // Talking: the outline and the words, the paper behind them, a reply
        // lit while pressed, and a reply that cannot be chosen.
        talk: (
            ink: "#0d0d0f",
            paper: "#fffffff7",
            paper_lit: "#dbdbdef7",
            greyed: "#9e9ea3",
        ),
        // The edit menu's buttons: the pictures on them, and each button's
        // fill, its fill while held, and its rim.
        edit_menu: (
            icon: "#ffffffeb",
            trash: "#ff5c545c",
            trash_held: "#ff5c549e",
            trash_rim: "#ff80789e",
            confirm: "#5cd6755c",
            confirm_held: "#5cd6759e",
            confirm_rim: "#99ffad9e",
            turn: "#5ca8ff5c",
            turn_held: "#5ca8ff9e",
            turn_rim: "#8cc7ff9e",
        ),
        // The punch's hit range, the band drawn on the ground in front of
        // you, turned the way you face (its shape is melee's near, reach,
        // width and cone, at the end of the file): its outline, and the
        // fill inside it, white, each as see-through as its alpha says.
        melee: (
            outline: "#ffffff99",
            fill: "#ffffff2b",
        ),
        // Bridge Wars (the PvP map): your health bar under your name, its
        // fill, what shows behind it as it empties, and its rim; and the
        // rim of an empty slot among the buttons bottom right, where a bow
        // or dynamite goes once bought.
        arena: (
            hp: "#d8352a",
            hp_back: "#00000059",
            hp_rim: "#000000b3",
            slot_rim: "#ffffff80",
            // The number that floats up off a body as a punch lands on it.
            damage: "#ff6a5a",
            // Everyone else's name over their head, in their team's colour:
            // red, blue, green and yellow, for the island at the bottom of
            // the map, the one on its left, the one at its top and the one
            // on its right. A zombie's, which is on no team, in its own.
            // And the bar under each name, a teammate's and an enemy's.
            // Each kept faint so as not to hide the fight (Hajun: "not
            // distracting").
            team_red: "#ff6b61d9",
            team_blue: "#6aa8ffd9",
            team_green: "#6fe07ed9",
            team_yellow: "#ffd95ad9",
            zombie: "#a8c79ac0",
            hp_ally: "#4fd46ab3",
            hp_enemy: "#e0402fb3",
            // The Player Compass Tracker's arrow round you, and the metres
            // written by it (the name by it is in its team's colour).
            compass: "#ffffffe6",
            // The bar over a team's respawn anchor: your own team's, and
            // another's.
            anchor_mine: "#4fd46acc",
            anchor_enemy: "#e0402fcc",
            // The respawn anchors themselves, each its team's colour: red
            // for the island at the bottom of the map, blue for the one on
            // its left, green for the one at its top and yellow for the
            // one on its right. Each glows in it by night, and lights its
            // island in a pale shade of it.
            anchor_red: "#e0352b",
            anchor_blue: "#2f6fe8",
            anchor_green: "#2fbf4a",
            anchor_yellow: "#f2c21e",
            // The planks of the bridges built as you walk: their tops and
            // their sides.
            plank: "#b98a52",
            plank_side: "#8a6238",
            // The minimap top right: the land, what shows round it (the
            // grey of your name's plate), you (a red dot) and your teammate
            // (a green dot). The bridges on it take the planks' colour
            // above.
            map_land: "#d9c9a8",
            map_back: "#66666673",
            map_me: "#ff3b30",
            map_mate: "#3ddc84",
            // The metres of bridge you have left, written in front of you
            // while you build: with plenty; from arena.bridge_low_at
            // metres down (10, at the end of this file), shading to the
            // third by arena.bridge_red_at (5); and from there to none.
            bridge_left: "#ffffff",
            bridge_low: "#ff9a2e",
            bridge_out: "#ff3b30",
            // The same number, written small inside the bridge button
            // among the buttons bottom right, under its plank, whether you
            // are building or not.
            bridge_count: "#ffffff",
            // What the two shops sell, as each one's picture is tinted on
            // its card and on the second button: the basic, the silver and
            // the aura sword; the basic, the advanced and the aura shield,
            // which is also the colour of the ball of force round whoever
            // has one (as see-through as its alpha says); the fireball;
            // the speed, the invisibility and the healing potion; the heal
            // pool; and the blindness trap.
            sword_basic: "#b9bec7",
            sword_silver: "#ffffff",
            sword_aura: "#3fc4d6",
            shield_basic: "#ffffff38",
            shield_advanced: "#ffd76a40",
            shield_aura: "#4fd9e84d",
            fireball: "#ff5a2a",
            potion_speed: "#4db8ff",
            potion_invisibility: "#c8d2de",
            potion_healing: "#ff5a6e",
            // The leap potion; the sparks left behind by someone running
            // fast on a speed potion, and by someone on a leap potion;
            // and what is written over your head while you are unseen
            // ("Invisible (12s)").
            potion_leap: "#52e05c",
            trail_speed: "#59c2ffe6",
            trail_leap: "#62f06ee6",
            unseen_text: "#ffffffe6",
            // A stick of dynamite: its two sticks (and its picture on its
            // card and its button); the fuse out of one end of it; and the
            // ring on the ground round where one lies, as far as its blast
            // will reach: its outline, and the fill inside it. (The thin
            // dark rim round that ring is aim_rim, below.)
            dynamite: "#e2382c",
            dynamite_fuse: "#8a5a2b",
            blast_outline: "#ff4a3ad9",
            blast_fill: "#ff3b3040",
            heal_pool: "#5fe08a",
            trap: "#d9d9d9",
            // The pips on an upgrade's card: a step taken, and one still
            // to take.
            pip: "#ffffff",
            pip_off: "#ffffff38",
            // The band on the ground that shows where a fireball or a
            // builder will go while you aim it: its outline, the fill
            // inside it, and the thin dark rim round the outside of it,
            // which is what shows the band over the sky off the edge of an
            // island or a bridge (white on the day's sky is all but
            // invisible).
            aim_outline: "#ffffffb3",
            aim_fill: "#ffffff33",
            aim_rim: "#00000080",
            // The time left of a drink, written in front of you while a
            // potion is at your mouth: "1.6" down to "0.0".
            drink: "#ffffff",
            // What covers the screen, all but a small circle round you,
            // while an enemy's trap has you blinded. The buttons, the
            // minimap and everything else round the edge stay over it.
            blind: "#000000",
            // What the generators make, as each one's picture is tinted
            // beside its count top left and in the shop: silver, gold,
            // sapphire and amethyst. (The things lying on the pads are
            // the models' own colours.)
            item_silver: "#e6e6e6",
            item_gold: "#f2b63a",
            item_sapphire: "#5b7dff",
            item_amethyst: "#cf5fe0",
            // The line in the upper half of the screen that says what has
            // just happened: "Sapphire generators have been upgraded to
            // Lvl II.", with the item's picture after its name.
            alert: "#ffffff",
            // What is written over and under each sapphire and amethyst
            // generator: its level, and the count to its next thing.
            generator: "#ffffff",
        ),
        // The friends' panel, behind the speech bubble under the gift: the
        // panel itself; a box that comes up over it (Add Friend, a
        // question, a message being written), and the dark over the panel
        // behind such a box.
        friends: (
            panel: "#1e1e1ee6",
            popup: "#101010f7",
            scrim: "#0000008c",
            // The line under the tab that is shown, and the picture of the
            // tab that is not; a heading ("Friends (2/5):").
            line: "#ffffff",
            tab_off: "#ffffff70",
            title: "#ffffff",
            // A friend's name, here and not here, and the line under it
            // that says where they are.
            name: "#ffffff",
            name_off: "#ffffff85",
            status: "#ffffffb8",
            // The disc behind someone's picture and the picture on it; and
            // the dot on its corner, here and not.
            avatar: "#5c5c5c",
            avatar_mark: "#ffffff",
            online: "#27c93f",
            offline: "#6b6b6b",
            // A round button on a row (ask into your group, the gear), lit
            // under the pointer, the picture on it, and the picture on one
            // that cannot be pressed just now.
            button: "#121212",
            button_lit: "#333333",
            button_mark: "#ffffff",
            button_off: "#ffffff3d",
            // The box something is typed into: a name to look for, a
            // message; and the words that stand in the search bar until
            // something is typed ("Friend's Username").
            field: "#2b2b2b",
            hint: "#ffffff59",
            // Yes and no (Yes, Accept, Send; Cancel, Reject), each lit
            // under the pointer, and the words on them.
            yes: "#1db81d",
            yes_lit: "#34d634",
            no: "#5c0d0d",
            no_lit: "#7d1717",
            on_choice: "#ffffff",
            // The count of what waits in your inbox, on the corner of the
            // speech bubble and of the envelope: the disc, and the number.
            badge: "#edb62a",
            badge_text: "#1a1a1a",
            // The gear's menu (Message, Remove Friend): an entry, one lit
            // under the pointer, and its outline.
            menu: "#000000",
            menu_lit: "#2e2e2e",
            menu_rim: "#ffffff",
            // The line along the bottom that says what came of something
            // ("Friend request sent.").
            notice: "#ffd98a",
            // Words that are pressed ("Add friend"), and words that only
            // say ("Requested").
            link: "#ffffff",
            link_off: "#ffffff80",
        ),
        // The chat box on the left of the screen, in the town and in
        // Bridge Wars: what shows behind the lines said, as see-through as
        // its alpha says; a line someone said, and the name before it
        // where they are on no team (in Bridge Wars a name is its team's
        // colour, arena.team_red and the rest); a line about what has
        // happened in the game ("Bob fell off the world."); the box a
        // line is typed into, at rest and while you type, the words
        // typed, and the words that stand in it until something is; and
        // the arrow that sends it, with something to send and with
        // nothing.
        chat: (
            back: "#00000073",
            text: "#ffffff",
            name: "#ffe9a8",
            event: "#ffffffc7",
            field: "#0000008c",
            field_lit: "#000000b3",
            typed: "#ffffff",
            hint: "#ffffff80",
            send: "#ffffffe6",
            send_off: "#ffffff59",
        ),
    ),
    // The font is Inter (since 2026-11-13; Bevy's own, plain ASCII, until
    // then): Latin, with every letter Vietnamese has, Greek and Cyrillic,
    // dashes and an ellipsis. Hangul is drawn too (since 2026-11-14, in
    // Pretendard), so a word here may be written in Korean. Where a word
    // has {something} in it, the game fills that in.
    words: (
        // Across the middle of the screen as you arrive in the town.
        welcome: "Donggeurami Town",
        signup: (
            title: "Donggeurami Town",
            start: "Start",
            have_account: "Already have an account?",
            log_in: "Log In",
            not_available: "Log in is not available yet",
            choose_name: "Choose Username",
            name_hint: "Shown to other players. 2-16 characters, or 8 in Korean.",
            // In the hint's place, and in the settings' Edit name, while
            // the name typed has a swear word in it and cannot be saved.
            name_refused: "Pick another name.",
            save: "Save",
            choose_character: "Choose Character",
            change_later: "You may change this later.",
        ),
        settings: (
            graphics: "Graphics",
            controls: "Controls",
            accounts: "Accounts",
            not_signed_up: "Not signed up",
            guest: "(Signed in as guest)",
            not_online: "Not online.",
            sign_in_google: "Sign in with Google",
            sign_in_apple: "Sign in with Apple",
            delete_account: "Delete account",
            edit_name: "Edit name",
            cancel: "Cancel",
            save: "Save",
            delete_sure: "Delete your account",
            delete_warning: "Your account stats go for good.\nThis cannot be undone.",
            delete: "Delete",
            deleting: "Deleting your account...",
            not_online_try: "Not online: try again",
            could_not_delete: "Could not delete it: try again",
        ),
        house_builder: (
            name: "Build Your Own House",
            rules: "Build and decorate your own house according to a theme. The best house wins!",
            pitch: "Want to play {name}? {rules}",
            cannot_pay: "You need {coins} coins to play.",
            play: "Play",
            later: "Later",
            players: "{count}/{seats} Players",
            waiting: "Waiting for players...",
            match_found: "Match found!",
            build_a_house: "Build a house!",
            theme_is: "Build a house! The theme is",
            who_lives_there: "Who Lives There: {who}",
            theme: "Theme: {what}",
            your_house: "Your house",
            a_house: "A house",
            whose_house: "{name}'s house",
            rate: "Rate this house",
            being_rated: "Everyone is rating your house",
            you_won: "You won!",
            you_came: "You came {place}",
            you: "You",
            back_in: "Back to the town in {time}",
            exit: "Exit",
            play_again: "Play again",
            price: "{coins} coins",
            need_coins: "Need {coins} coins",
            reconnecting: "Reconnecting...",
            lost_connection: "Lost the connection",
        ),
        shop: (
            one_house: "One house to a plot: bin yours to choose another.",
            house_first_openings: "Put a house down first: these go in its walls.",
            house_first_hangings: "Put a house down first to hang things on its walls.",
        ),
        talk: (
            house_builder: "House Builder",
            someone: "Someone",
            // What the town's AIs say, and what you say back: one of these at
            // random, never the same twice running.
            small_talk: [
                ("Hi there! Isn't Donggeurami Town lovely today?", "It really is!"),
                ("Did you know the fountain throws you up in the air if you stand in its top bowl?", "I'll try it!"),
                ("The buses go all the way round town. Hop on one sometime!", "Sounds fun!"),
                ("I heard the House Builder is looking for builders. Have you played?", "Maybe later!"),
                ("I love walking round the pond. It's so peaceful here.", "Me too!"),
                ("When the street lamps come on at night, the whole town glows.", "I'll stay up for it!"),
                ("Have you seen the sunset? The sky goes all pink and orange.", "Not yet!"),
                ("I'm just out for a stroll. Lovely weather for it!", "Enjoy your walk!"),
                ("Someday I want a house with a roof terrace.", "Good luck!"),
                ("Can you hear the music? I could listen to it all day.", "It's catchy!"),
                ("I tried to jump onto a bus roof once. Way too high!", "Nice try!"),
                ("Every house in town has a door that opens. I checked them all!", "That's dedication!"),
                ("Careful by the pond. It's shallow, but my shoes still got wet!", "I'll be careful!"),
                ("Hello! Have we met before? You look familiar.", "Nice to meet you!"),
                ("I'm saving up my coins for something special.", "Good idea!"),
                ("The stars come out at night. Have you ever looked up?", "I'll look tonight!"),
                ("Sometimes I just stand here and watch the buses go by.", "Sounds relaxing!"),
            ],
        ),
        online: (
            new_version: "A new version is out",
            update_to_play: "Update the app to play online",
        ),
        // The game selector, behind the gamepad button down the right edge:
        // its title, the three games (the third not to be had yet), and
        // what each costs.
        games: (
            title: "Games",
            bridge_wars: "Bridge Wars",
            home_builders: "Home Builders",
            coming_soon: "???",
            coming_soon_note: "Coming soon",
            free: "Free",
        ),
        // Bridge Wars: the board top centre, in the waiting room over the
        // map and in the game, and the headlines across the screen.
        arena: (
            name: "Bridge Wars",
            players: "{count}/{seats} Players",
            waiting: "Waiting for players...",
            match_found: "Match found!",
            fight: "Fight!",
            // Across the screen while you are dead, counting down in
            // halves: "4", "3.5", ... "0.5".
            died: "You died. Respawning in {seconds}...",
            // A team, by its colour: {team} is one of the four words under
            // it, red for the island at the bottom of the map, blue for the
            // one on its left, green for the one at its top and yellow for
            // the one on its right. And what is said under "Fight!" as the
            // game begins, of your own.
            team: "Team {team}",
            team_red: "Red",
            team_blue: "Blue",
            team_green: "Green",
            team_yellow: "Yellow",
            your_team: "You are on {team}",
            // The panel when you are dead with your anchor gone, and the
            // headlines as an anchor breaks, another team's and your own.
            out: "You're out!",
            anchor_gone: "Your respawn anchor is gone.",
            anchor_destroyed: "{team}'s anchor destroyed!",
            your_anchor_destroyed: "Your anchor was destroyed!",
            // The headline at the end: how it went for you, over who won
            // (or that the time ran out); and the panel's buttons.
            victory: "Victory!",
            defeat: "Defeat",
            times_up: "Time's up!",
            team_wins: "{team} wins!",
            play_again: "Play again",
            exit: "Exit",
            // What the generators make, as each is called in the lines
            // below.
            silver: "Silver",
            gold: "Gold",
            sapphire: "Sapphire",
            amethyst: "Amethyst",
            // The lines in the upper half of the screen as the game's
            // timetable moves on: a generator's tier raised ({level} is I,
            // II or III; the item's picture is drawn right after {item},
            // so keep {item} in the line), every anchor broken at 10:00,
            // and sudden death at 15:00; and the line under "Time's up!"
            // at 25:00.
            tier_up: "{item} generators have been upgraded to Lvl {level}.",
            anchors_broken: "All respawn anchors have been destroyed.",
            sudden_death: "Sudden death! Zombies are loose on the map.",
            draw: "The game is a draw.",
            // Over each sapphire and amethyst generator, its level
            // ({level} is 1, 2 or 3), and under it the seconds to its next
            // thing, counting down.
            generator: "{item} Generator Lvl {level}",
            generator_next: "Next {item} in {seconds}sec...",
            // A blindness trap going off: said to whoever it has blinded,
            // and to the team whose island it was on.
            blinded: "A trap has blinded you!",
            trap_sprung: "An enemy walked into your trap!",
            // Someone has hit your team's respawn anchor, and it still
            // stands: said in the same line, every few seconds at the most.
            anchor_attacked: "Your anchor is under attack!",
            // Written over your head while you are unseen, counting down.
            invisible: "Invisible ({seconds}s)",
        ),
        // Bridge Wars' two shops: the item shop at the red stand on each
        // island and the upgrade shop at the blue one. Their titles; what a
        // card says in place of a price when the thing is yours already, when
        // there is no more of it to buy, and when the second button holds
        // something else; and each thing's name with the one line under it.
        // A {number} in a line comes out of the game's rules
        // (shared/src/lib.rs, bridge_wars), so the line follows the rules.
        market: (
            items: "Shop",
            upgrades: "Upgrades",
            owned: "Owned",
            max: "Max",
            taken: "Slots full",
            bridge: "Bridge",
            bridge_stat: "+{metres}m",
            // The swords and the shields, by tier.
            swords: ("Basic", "Silver", "Aura"),
            sword_stat: "+{damage} dmg",
            shields: ("Basic", "Advanced", "Aura"),
            shield_stat: "-{share}% dmg",
            // What goes on the second button.
            fireball: "Fireball",
            fireball_stat: "{damage} dmg",
            builder: "Builder",
            builder_stat: "{metres}m",
            speed: "Speed",
            speed_stat: "+{more}% {seconds}s",
            invisibility: "Invisible",
            invisibility_stat: "{seconds}s",
            healing: "Heal",
            healing_stat: "+{share}% hp",
            dynamite: "Dynamite",
            dynamite_stat: "Cuts bridges",
            leap: "Leap",
            leap_stat: "x{times} jump {seconds}s",
            // The upgrade shop. The generator's four steps, each with its
            // line; the rest once, or step by step.
            forge: ("Better Generator", "Advanced Generator", "Amethyst Generator", "Molten Generator"),
            forge_stats: ("x1.5 faster", "x2 faster", "+ Amethyst", "x3 faster"),
            stronger_swords: "Stronger Swords",
            stronger_swords_stat: "+{damage} dmg",
            better_shields: "Better Shields",
            better_shields_stat: "-{share}% dmg",
            heal_pool: "Heal Pool",
            heal_pool_stat: "Base +{health}hp",
            trap: "Blindness Trap",
            trap_stat: "Blinds {seconds}s",
            // The Player Compass Tracker, in the item shop.
            compass: "Tracker",
            compass_stat: "Nearest foe",
            // The upgrade shop's builders, step by step: how fast your
            // team walks carrying a plank, and the builders its Bridge
            // Builders send, as a share of a run ({percent}).
            build_speed: ("Advanced Builder", "Master Builder", "Grand Builder"),
            build_speed_stat: "{percent}% speed",
        ),
        // The friends' panel. Its two headings: {online} of {all} your
        // friends are here; {count} of {most} are in your group. Who leads
        // a group, and which of it is you. A level.
        friends: (
            friends: "Friends ({online}/{all}):",
            group: "Group ({count}/{most}):",
            leader: "Leader",
            you: "You",
            level: "Level {level}",
            // With nobody in a list, nothing in the inbox, and no
            // connection.
            no_friends: "No friends.",
            no_mail: "All Caught Up.",
            not_online: "You are offline. Friends need a connection.",
            // Add Friend: its title; beside each player found, what is
            // pressed to ask them, what stands there once they are asked
            // or your friend, and yes and no to one who asked you; your
            // own name and tag, and what copying it says; what stands in
            // the search bar until something is typed; and what a search
            // that found nobody says.
            add_friend: "Add Friend",
            add: "Add friend",
            asked: "Requested",
            is_friend: "Friends",
            accept: "Accept",
            reject: "Reject",
            my_id: "My ID",
            copied: "Copied",
            search_hint: "Friend's Username",
            nobody: "Nobody goes by that name.",
            // The inbox: under the name of someone who asked to be your
            // friend, and of someone who asked you into their group; and
            // the buttons beside an invitation and beside a message.
            wants_friend: "wants to be your friend",
            wants_group: "invites you to their group",
            join: "Join",
            reply: "Reply",
            seen: "OK",
            // The two questions, with their buttons.
            invite_ask: "Would you like to invite\n{name}\nto your group?",
            remove_ask: "Remove\n{name}\nfrom your friends?",
            cancel: "Cancel",
            yes: "Yes",
            // The gear's menu beside a friend, and leaving your group.
            message: "Message",
            remove: "Remove Friend",
            leave: "Leave",
            // Writing to a friend.
            message_to: "Message {name}",
            send: "Send",
            // Where a friend is, under their name: in channel {channel} of
            // the town, at home, in a game ({game} is a game's name from
            // `games`, above), or gone for {time}, which is made of one of
            // the pairs after it, for one and for many ({n} is how many),
            // or, for under a minute, of the word before them.
            in_town: "In Main Lobby #{channel}",
            at_home: "At home",
            in_queue: "{game}: In Queue",
            in_game: "{game}: In Game",
            offline: "Offline",
            offline_for: "Offline for {time}",
            moments: "a moment",
            minutes: ("{n} minute", "{n} minutes"),
            hours: ("{n} hour", "{n} hours"),
            days: ("{n} day", "{n} days"),
            // What the panel says of what came of something you asked.
            said: (
                asked: "Friend request sent.",
                befriended: "You are friends now!",
                unfriended: "Removed.",
                already: "Already done.",
                full: "Your friends list is full.",
                theirs_full: "Their friends list is full.",
                no_such: "No such player.",
                not_friend: "They are not your friend.",
                offline: "They are offline.",
                invited: "Invited to your group.",
                not_leader: "Only the group's leader can do that.",
                group_full: "The group is full.",
                stale: "That is no longer there.",
                sent: "Message sent.",
                inbox_full: "Their inbox is full.",
                not_a_message: "That cannot be sent.",
                left_behind: "Your group started a game without you.",
            ),
            // Across the screen as your group's leader takes you into a
            // game; and in the game selector, to anyone in a group who
            // does not lead it.
            summoned: "Your group is playing {game}",
            only_leader: "Only your group's leader can start a game.",
        ),
        // The chat box. What stands in the box you type into until you
        // type; a line someone said; and what Bridge Wars says as a game
        // goes: {name} fell, {killer} knocked {name} off, or killed them,
        // with a bare hand or with {weapon} (one of the three swords, a
        // fireball, dynamite); {name} bought {ware} for your team (the
        // upgrade shop's own name for it); and {name} broke {team}'s
        // anchor. Every name is drawn in its team's colour.
        chat: (
            hint: "Type a message",
            said: "{name}: {text}",
            fell: "{name} fell off the world.",
            knocked: "{killer} knocked {name} off the world.",
            killed: "{killer} killed {name}.",
            killed_with: "{killer} killed {name} with {weapon}.",
            swords: ("a Basic Sword", "a Silver Sword", "an Aura Sword"),
            fireball: "a Fireball",
            dynamite: "Dynamite",
            bought: "{name} purchased {ware} for your team.",
            anchor_broken: "{name} destroyed {team}'s anchor.",
        ),
    ),
    // The car you drive (the face button, or C on desktop): every number of
    // how it goes, in metres, seconds and degrees, with or without a point
    // (12 and 12.0 both read). Save while driving and the car takes the new
    // numbers at once. A number that would break the car (a rate under 0, a
    // speed divided by at 0, a range inside out) is refused: the game logs
    // why and keeps the last good file.
    car: (
        // Speeds, in metres a second. A run and a bus are 7, a bus on the
        // road round the edge of the town 14. Cruising is with the stick
        // pushed all the way (less, pushed less); boost is with the jump
        // button held (Space); reverse is with the fist held (F). Online the
        // server lets a body go no faster than 40 (DRIVEN_TOP_SPEED in
        // shared/src/lib.rs, with some slack): boosting or reversing faster
        // than that, it puts you back every second or so.
        cruise: 15.0,
        boost: 30.0,
        reverse: 30.0,
        // How fast it gains speed, in metres a second a second: cruising;
        // boosting or reversing; and how fast it loses it, with the stick
        // let go, or the reverse pressed while going forward.
        accel: 30.0,
        boost_accel: 60.0,
        brake: 60.0,
        // Turning: the tightest circle it goes round, as the radius its back
        // wheels follow, in metres, at easy_speed (metres a second) and
        // slower; faster, the circle grows in proportion to the speed (at
        // twice easy_speed, twice as wide), so that a corner taken boosting
        // is taken wide. The roads are 12 m wide: at 4.5, a U-turn takes 12
        // m from the outside of the car to the outside.
        tightest: 3.5,
        easy_speed: 8.0,
        // How fast the front wheels turn, in degrees a second; and how far
        // off the way the stick points, in degrees, they are turned all the
        // way (nearer the stick, in proportion: smaller is twitchier).
        steer_rate: 286.0,
        full_lock_at: 14.3,
        // Stopped against a wall with the stick pushed, it steers as if going
        // this fast, in metres a second, so that it comes round rather than
        // standing with its wheels turned.
        creep: 3.0,
        // The gun: hold the gift button (G on desktop) in the car and bullets
        // come out of its nose, each going this fast, in metres a second, one
        // every this many seconds while the button is held (the first as it
        // goes down), gone once this far, in metres, from where it was fired,
        // and each a ball of this radius, in metres. They hit nothing yet.
        bullet_speed: 60.0,
        bullet_every: 0.12,
        bullet_range: 40.0,
        bullet_radius: 0.12,
        // The camera over you, in metres, fixed straight down over you in
        // and out of the car (since 2026-11-07, out of it too): where it
        // starts as the app opens, and the nearest and the furthest it
        // zooms.
        overhead: 24.0,
        overhead_nearest: 7.0,
        overhead_furthest: 60.0,
        // How its nose and tail feel for walls (seldom worth touching): each
        // is felt as a circle of this radius, in metres, its middle this far
        // back from the car's very end, between these heights over your
        // feet (over a kerb, a step and a planter, 0.5 m; under its roof);
        // and how much of the move it asked for the car has to make, as a
        // share from 0 to 1, before it counts as stopped by what it met and
        // loses its speed.
        end_radius: 1.2,
        end_back: 0.6,
        felt_low: 0.55,
        felt_high: 1.3,
        stopped_short: 0.3,
    ),
    // The punch (the fist button, F on desktop), as Minecraft 1.8.9's sword:
    // the numbers are Minecraft's, its blocks a tick made metres a second
    // (times 20) and its ticks made seconds (a twentieth each).
    melee: (
        // The swing: the arm out, and back, in seconds. Minecraft's is 6
        // ticks, 0.3 s. There is no cooldown on the punch itself, as there
        // was none in 1.8.9: every press swings, and lands if it can.
        swing_out: 0.12,
        swing_back: 0.18,
        // A punch lands on the nearest body with any of itself in the range
        // drawn on the ground in front of you (in colours.melee's colours):
        // a band from near out to reach, in metres from your middle (0.45
        // is your own body's edge), width across where it begins, in
        // metres, and opening out by cone degrees from there, the sides of
        // a sector whose point lies behind you (with a width of 0, a point
        // near in front of you); no higher or lower than a body. Minecraft's
        // reach is 3 blocks, eyes to hitbox, with the crosshair on them; a
        // stick is less precise than a mouse.
        reach: 2.0,
        near: 0.45,
        width: 1.5,
        cone: 45.0,
        // Once a punch has landed on a body, no other moves it for this
        // long, in seconds: Minecraft's 10 ticks of hurt resistance, so at
        // most two knocks a second however fast the presses come.
        hurt_time: 0.5,
        // How hard: knocked away from the puncher at knock_back metres a
        // second (a little over Minecraft's 0.4 blocks a tick, 8, since the
        // night of 2026-11-07: "increase knockback slightly"), and
        // sprint_bonus more if the puncher was on the move (its sprint hit,
        // 0.5 more), whatever they were already carried by halved first;
        // and up at knock_up (0.4 blocks a tick; a jump here is 8.5).
        knock_back: 10.0,
        sprint_bonus: 10.0,
        knock_up: 8.0,
        // How fast the knock dies away: what is left of it each twentieth
        // of a second, as Minecraft counts, in the air and on the ground
        // (its 0.91 air drag, and 0.6 ground friction times 0.91).
        air_drag: 0.91,
        ground_drag: 0.546,
    ),
    // Bridge Wars, as it is fought (the night of 2026-11-07): everyone runs
    // there at run_speed metres a second (a walk is 7), everyone has
    // health to start and loses damage of it to every punch that lands
    // (one punch in hurt_time, above), gets regen_per_sec of it back a
    // second once nobody has hit them for regen_after seconds, and at none
    // is dead for respawn_secs before standing again in the middle of
    // their island; a bot goes for whoever is within hunt_radius metres of
    // it and punches no oftener than every bot_punch_every seconds, and
    // runs away from whoever is nearest while it has less than flee_below
    // of its health (a share, 0 to 1). Falling off the map is death too,
    // fall_to_die metres below it. Each team's respawn anchor, the purple
    // pillar on its island, starts with anchor_health: ten punches
    // (2026-11-09; twenty the day before); broken, its team's dead stay
    // dead. Everyone starts a game with bridge_metres of bridge to lay
    // (none: it is bought at the shop, 25 m for 4 silver; the number is
    // written in front of you while you build), and lays it a plank at a
    // time until it runs out. These numbers rule offline; online the
    // server plays by the same ones built into it
    // (roundtown_net::bridge_wars), but for the metres you start with,
    // which are this file's online too. How fast the generators make
    // silver, gold, sapphire and amethyst, how many each pad holds, what
    // the shop charges and when each thing on the game's timetable
    // happens are not here: both sides play by
    // shared/src/lib.rs (bridge_wars), from bridgewarsgameevent.txt.
    arena: (
        run_speed: 10.0,
        health: 100.0,
        damage: 12.0,
        respawn_secs: 4.0,
        regen_after: 5.0,
        regen_per_sec: 4.0,
        hunt_radius: 24.0,
        bot_punch_every: 0.8,
        flee_below: 0.2,
        fall_to_die: 30.0,
        anchor_health: 120.0,
        bridge_metres: 0.0,
        // The number of metres written in front of you while you build
        // turns orange with this many left (colours.arena.bridge_low), and
        // by this many it is red (bridge_out). With none left, building
        // turns itself off and you are stopped where you stand until you
        // let go of the stick.
        bridge_low_at: 10.0,
        bridge_red_at: 5.0,
        // The camera in Bridge Wars: fixed straight down over you this far
        // up, in metres (as car.overhead is, over your chest), and nothing
        // zooms it. At 15.5 an island, 20.8 m across, just fits the height
        // of the screen with you in its middle; a bigger number shows more
        // round it.
        camera_height: 15.5,
        // How a sword is held and swung: Chop, on its edge ("narrow") and
        // cut downward from over the right shoulder to low on the left
        // (since 2026-11-12), or Sweep, the first way, held flat and
        // swept level across in front from right to left. Both are still
        // in the game: change the word to go back.
        sword_swing: Chop,
        // How far the sword is tilted while it is held at the ready, the
        // Chop way, in degrees from straight up: forward, toward where you
        // face, and over to your right. 0 and 0 is a sword held straight
        // up, which the camera over you sees end on, as a dot; 61 and 36
        // was the first try, which was too tilted.
        sword_tilt_forward: 30,
        sword_tilt_side: 10,
    ),
)
