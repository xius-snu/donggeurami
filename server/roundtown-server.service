# The game server, as a systemd service on the Vultr VM. `server/deploy.sh`
# installs this as /etc/systemd/system/roundtown-server.service.
#
# It runs as its own user, `roundtown`, with nothing it can write but its own
# data directory, and the one privilege it needs: to listen on port 443,
# under 1024.

[Unit]
Description=Donggeurami Town game server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=roundtown
Group=roundtown
# RT_PORT, RT_ALLOW_SKIP, and from phase 2 the database and the login's keys.
EnvironmentFile=-/etc/roundtown/env
ExecStart=/opt/roundtown/roundtown-server
WorkingDirectory=/var/lib/roundtown
Restart=always
RestartSec=2

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/roundtown
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
